# Independent BabiesPicks configuration. Never copy Tariq credentials or tokens.
MCP_PORT=8765
MCP_PUBLIC_URL=http://localhost:8765
DATABASE_URL=
# Optional server-to-server editor token, at least 32 random characters. Never publishes.
MCP_BEARER_TOKEN=
# Configure both for browser OAuth. Secret >=32 characters; owner password >=12.
MCP_OAUTH_SECRET=
MCP_ADMIN_PASSWORD=
# Publishing needs both this switch and explicit owner approval in OAuth.
ENABLE_MCP_PUBLISH=false
# Optional together. Public cache updates are best effort after saved mutations.
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
# Explicit exception only for http://web:3000/api/revalidate inside Docker.
WEB_REVALIDATE_ALLOW_INTERNAL_HTTP=false
# Shared with the web server; persistent volume, not container-local storage.
MEDIA_ROOT=
