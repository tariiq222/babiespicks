generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum DataSource {
  SCHEMA_ORG
  AI_EXTRACTION
  MANUAL
}

enum VerdictType {
  WORTH_IT
  WORTH_IT_WITH
  WAIT
  NOT_WORTH_IT
}

enum ContentType {
  BEST_LIST
  PRODUCT_REVIEW
  BUYING_GUIDE
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  NEEDS_REVIEW
  USED_UP
  INVALID
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ContentStatus {
  DRAFT
  SEO_CHECK
  QUALITY_CHECK
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REVISION_REQUESTED
  REJECTED
}

enum ProductStatus {
  DISCOVERED
  DATA_ACQUIRED
  REVIEWS_ANALYZED
  VERDICT_GENERATED
  READY
  ACTIVE
  INACTIVE
  REJECTED
}

enum ReviewItemStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum TrendSignalStatus {
  NEW
  PROMOTED_TO_DRAFT
  DISMISSED
  ARCHIVED
}

enum ProductDraftStatus {
  NEEDS_REVIEW
  APPROVED
  REJECTED
  NEEDS_EDIT
  PUBLISHED
  ARCHIVED
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  REJECTED
}

enum ProductScoreStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum ArticleDraftStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
}

enum ScheduledJobStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum ScheduledJobRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
}

enum OptimizationRecommendationStatus {
  OPEN
  APPROVED
  DISMISSED
  APPLIED
  ARCHIVED
}

enum RetentionClass {
  SHORT_LIVED
  STANDARD
  GENERATED_CONTENT
  AUDIT
}

enum ApprovalAuditActorType {
  ADMIN_API_KEY
  SYSTEM
  USER
}

enum ApprovalAuditAction {
  APPROVED
  REJECTED
  SCHEDULED
  REVISION_REQUESTED
  PUBLISHED
}

enum ApprovalAuditEntityType {
  CONTENT_PAGE
  SOCIAL_POST
  ARTICLE_DRAFT
  PRODUCT_DRAFT
  PRODUCT_SCORE
}

// ==================== AI OS ENUMS ====================

enum AiRunType {
  PRODUCT_PIPELINE
  CONTENT_PIPELINE
  DISCOVERY
  CONTENT_SPRINT
  MANUAL
}

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum AiArtifactType {
  TEXT
  IMAGE
  JSON
  URL
}

enum AiEventType {
  INFO
  WARNING
  ERROR
  APPROVAL_REQUIRED
  CHECKPOINT
  QUEUED
  STARTED
  COMPLETED
}

enum AiApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== MODELS ====================

model Store {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  url              String
  logoUrl          String?
  affiliateNetwork String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  products        Product[]
  prices          ProductPrice[]
  coupons         Coupon[]
  affiliateClicks AffiliateClick[]

  @@map("stores")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  order       Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  createdAt   DateTime   @default(now())

  products     Product[]
  contentPages ContentPage[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id         String        @id @default(cuid())
  name       String
  slug       String        @unique
  brand      String?
  imageUrl   String?
  storeId    String?
  store      Store?        @relation(fields: [storeId], references: [id])
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id])
  sourceUrl  String?       @unique
  dataSource DataSource    @default(MANUAL)
  confidence Float?
  isActive   Boolean       @default(true)
  status     ProductStatus @default(DISCOVERED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  translations                ProductTranslation[]
  prices                      ProductPrice[]
  specs                       ProductSpec[]
  reviewSummary               ProductReviewSummary?
  verdict                     Verdict?
  affiliateClicks             AffiliateClick[]
  agentJobs                   AgentJob[]
  socialPosts                 SocialPost[]
  productScores               ProductScore[]
  analyticsEvents             AnalyticsEvent[]
  optimizationRecommendations OptimizationRecommendation[]

  @@index([categoryId])
  @@index([storeId])
  @@index([slug])
  @@index([status])
  @@map("products")
}

model TrendSignal {
  id                String            @id @default(cuid())
  source            String
  sourceUrl         String?
  canonicalUrl      String?           @unique
  rawTitle          String
  normalizedTitle   String            @unique
  sourceHash        String            @unique
  discoveryReason   String            @db.Text
  trendScore        Float
  demandSignal      String?           @db.Text
  competitionSignal String?           @db.Text
  seasonalitySignal String?           @db.Text
  metadata          Json?
  status            TrendSignalStatus @default(NEW)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  productDrafts               ProductDraft[]
  optimizationRecommendations OptimizationRecommendation[]

  // Affiliate AI OS Phase 1 reads/deduplicates by status, score, URL/title, and source hash.
  @@index([status, trendScore])
  @@index([status, createdAt])
  @@map("trend_signals")
}

model ProductDraft {
  id                       String             @id @default(cuid())
  trendSignalId            String?
  trendSignal              TrendSignal?       @relation(fields: [trendSignalId], references: [id], onDelete: SetNull)
  title                    String
  description              String?            @db.Text
  imageUrl                 String?
  price                    Decimal?           @db.Decimal(10, 2)
  sourceUrl                String?
  canonicalUrl             String?            @unique
  affiliateUrl             String?
  category                 String?
  sourceType               String?
  normalizedTitle          String             @unique
  sourceHash               String             @unique
  discoveryReason          String             @db.Text
  trendScore               Float
  demandSignal             String?            @db.Text
  competitionSignal        String?            @db.Text
  seasonalitySignal        String?            @db.Text
  rawData                  Json?
  status                   ProductDraftStatus @default(NEEDS_REVIEW)
  approvedBy               String?
  approvedAt               DateTime?
  rejectedBy               String?
  rejectedAt               DateTime?
  rejectionReason          String?            @db.Text
  editNotes                String?            @db.Text
  transitionIdempotencyKey String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  productScores ProductScore[]

  // Affiliate AI OS Phase 1 review queues and dedupe paths filter by status, score, URL/title, and source hash.
  @@index([trendSignalId])
  @@index([status, trendScore])
  @@index([status, createdAt])
  @@index([transitionIdempotencyKey])
  @@map("product_drafts")
}

model ProductTranslation {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale          String // "ar" | "en"
  name            String
  description     String?
  slug            String
  metaTitle       String?
  metaDescription String?

  @@unique([productId, locale])
  @@index([locale, slug])
  @@map("product_translations")
}

model ProductPrice {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  currency      String   @default("SAR")
  url           String?
  inStock       Boolean  @default(true)
  scrapedAt     DateTime @default(now())

  @@index([productId, scrapedAt])
  @@index([storeId])
  @@map("product_prices")
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  locale    String  @default("ar")

  @@index([productId])
  @@map("product_specs")
}

model ProductReviewSummary {
  id             String   @id @default(cuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  averageRating  Float
  totalReviews   Int
  sentimentScore Float // -1 to 1
  prosAr         Json?
  prosEn         Json?
  consAr         Json?
  consEn         Json?
  redFlags       Json?
  analyzedAt     DateTime @default(now())

  @@map("product_review_summaries")
}

model Verdict {
  id            String      @id @default(cuid())
  productId     String      @unique
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          VerdictType
  overallScore  Float
  safetyScore   Float
  qualityScore  Float
  reviewsScore  Float
  priceScore    Float
  longTermScore Float
  reasoningAr   String      @db.Text
  reasoningEn   String      @db.Text
  conditionsAr  Json?
  conditionsEn  Json?
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("verdicts")
}

model ContentPage {
  id              String        @id @default(cuid())
  type            ContentType
  slug            String        @unique
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  status          ContentStatus @default(DRAFT)
  seoScore        Float?
  seoScoreAr      Float?
  seoScoreEn      Float?
  qualityScore    Float?
  approvedAt      DateTime?
  approvedBy      String?
  scheduledAt     DateTime?
  revisionNotes   String?       @db.Text
  rejectionReason String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  translations                ContentPageTranslation[]
  publishedPosts              PublishedPost[]
  socialPosts                 SocialPost[]
  articleDrafts               ArticleDraft[]
  analyticsEvents             AnalyticsEvent[]
  optimizationRecommendations OptimizationRecommendation[]

  @@index([type])
  @@index([categoryId])
  @@index([status])
  @@map("content_pages")
}

model ContentPageTranslation {
  id              String      @id @default(cuid())
  contentPageId   String
  contentPage     ContentPage @relation(fields: [contentPageId], references: [id], onDelete: Cascade)
  locale          String
  title           String
  content         String      @db.Text
  metaTitle       String?
  metaDescription String?
  excerpt         String?

  @@unique([contentPageId, locale])
  @@map("content_page_translations")
}

model Coupon {
  id              String       @id @default(cuid())
  code            String
  storeId         String
  store           Store        @relation(fields: [storeId], references: [id])
  discountPercent Float?
  discountAmount  Decimal?     @db.Decimal(10, 2)
  description     String?
  status          CouponStatus @default(ACTIVE)
  validFrom       DateTime?
  validUntil      DateTime?
  expiredReason   String?
  totalClicks     Int          @default(0)
  verified        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([storeId])
  @@index([status])
  @@map("coupons")
}

model AffiliateClick {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userAgent String?
  referrer  String?
  ipHash    String?
  sessionId String?
  locale    String?
  country   String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@map("affiliate_clicks")
}

model AgentJob {
  id          String    @id @default(cuid())
  agentName   String
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  status      JobStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?   @db.Text
  tokensUsed  Int?
  costUsd     Decimal?  @db.Decimal(10, 6)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([agentName, status])
  @@index([productId])
  @@map("agent_jobs")
}

model PublishedPost {
  id            String      @id @default(cuid())
  contentPageId String
  contentPage   ContentPage @relation(fields: [contentPageId], references: [id], onDelete: Cascade)
  channel       String // "website", "telegram", "twitter"
  publishedAt   DateTime    @default(now())
  metadata      Json?

  @@index([contentPageId])
  @@map("published_posts")
}

model SocialPost {
  id              String           @id @default(cuid())
  contentPageId   String?
  contentPage     ContentPage?     @relation(fields: [contentPageId], references: [id])
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id])
  status          SocialPostStatus @default(DRAFT)
  platform        String           @default("twitter") // "twitter", "instagram", etc.
  format          String // "thread_ar", "thread_en", "single_ar", "single_en"
  content         Json // Array of tweet objects: [{text, mediaUrl?}]
  hashtags        String[]
  visualUrl       String? // URL to generated verdict card image
  complianceScore Float?
  complianceNotes String?          @db.Text
  scheduledAt     DateTime?
  publishedAt     DateTime?
  externalId      String? // Twitter post ID after publishing
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  analyticsEvents             AnalyticsEvent[]
  optimizationRecommendations OptimizationRecommendation[]

  @@index([contentPageId])
  @@index([productId])
  @@index([status])
  @@index([platform, status])
  // Normalized schedule-slot uniqueness for twitter/x aliases is enforced by
  // raw SQL migration 0007_social_normalized_schedule_slots.
  @@map("social_posts")
}

model ProductScore {
  id             String             @id @default(cuid())
  productDraftId String?
  productDraft   ProductDraft?      @relation(fields: [productDraftId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  aiRunId        String?
  aiRun          AiRun?             @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  idempotencyKey String?            @unique
  scores         Json
  reasoning      Json?
  riskFlags      Json?
  recommendation String?
  status         ProductScoreStatus @default(DRAFT)
  retentionClass RetentionClass     @default(GENERATED_CONTENT)
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Score review queues filter by status and latest update; retention cleanup scans by class/expiry.
  @@index([status, updatedAt])
  @@index([retentionClass, expiresAt])
  @@index([expiresAt])
  @@index([productDraftId, status])
  @@index([productId, status])
  @@index([aiRunId])
  @@map("product_scores")
}

// OfferEnrichment - Phase 2 affiliate AI OS offer enrichment data
model OfferEnrichment {
  id                    String    @id @default(cuid())
  sourceProductDraftId   String
  offerTitle            String?
  targetAudience        String?
  keyBenefits           String?
  painPoints            String?
  objections            String?
  positioningAngle      String?
  contentAngles         String?
  suggestedHooks        String?
  keywords              String?
  confidenceScore       Float?
  enrichmentReason      String?   @db.Text
  status                String    @default("PENDING") // PENDING | COMPLETED | FAILED
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  contentDrafts         ContentDraft[]

  @@index([sourceProductDraftId])
  @@index([status])
  @@map("offer_enrichments")
}

// ContentDraft - Phase 2 affiliate AI OS content drafts
model ContentDraft {
  id                      String    @id @default(cuid())
  sourceOfferEnrichmentId String
  sourceOfferEnrichment   OfferEnrichment @relation(fields: [sourceOfferEnrichmentId], references: [id])
  contentType             String    // article | social_post | email | ad_copy
  title                   String?
  body                    String?   @db.Text
  angle                   String?
  callToAction            String?
  status                  String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED
  idempotencyKey          String?   @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  reviewItems             ReviewItem[]
  publicOfferDraft       PublicOfferDraft?

  @@index([sourceOfferEnrichmentId])
  @@index([status])
  @@map("content_drafts")
}

// ReviewItem - Phase 3 content review workspace
model ReviewItem {
  id               String          @id @default(cuid())
  contentDraftId   String
  contentDraft     ContentDraft    @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  reviewStatus     ReviewItemStatus @default(PENDING)
  reviewNotes      String?         @db.Text
  revisionRequested Boolean         @default(false)
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([reviewStatus])
  @@index([contentDraftId])
  @@index([createdAt])
  @@map("review_items")
}

enum PublicOfferDraftStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model PublicOfferDraft {
  id                   String                   @id @default(cuid())
  sourceContentDraftId String                   @unique
  sourceContentDraft   ContentDraft             @relation(fields: [sourceContentDraftId], references: [id])
  slug                 String?                  @unique
  publicOffer          PublicOffer?
  title                String?
  summary              String?                  @db.Text
  heroCopy             String?                  @db.Text
  benefits             Json?                    
  faq                  Json?                    
  seoTitle             String?
  seoDescription       String?                  @db.Text
  status               PublicOfferDraftStatus   @default(DRAFT)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status])
  @@index([sourceContentDraftId])
  @@map("public_offer_drafts")
}

model PublicOffer {
  id                      String       @id @default(cuid())
  sourcePublicOfferDraftId String       @unique
  sourcePublicOfferDraft   PublicOfferDraft @relation(fields: [sourcePublicOfferDraftId], references: [id])
  slug                    String       @unique
  title                   String
  body                    String       @db.Text
  seoTitle                String?
  seoDescription          String?      @db.Text
  publishedAt             DateTime?
  unpublishedAt           DateTime?
  status                  String       @default("DRAFT")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@map("public_offers")
}

model ArticleDraft {
  id              String             @id @default(cuid())
  contentPageId   String?
  contentPage     ContentPage?       @relation(fields: [contentPageId], references: [id], onDelete: SetNull)
  aiRunId         String?
  aiRun           AiRun?             @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  idempotencyKey  String?            @unique
  locale          String
  type            ContentType
  title           String
  slug            String
  outline         Json?
  content         String?            @db.Text
  productIds      String[]
  seo             Json?
  status          ArticleDraftStatus @default(DRAFT)
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?            @db.Text
  revisionNotes   String?            @db.Text
  retentionClass  RetentionClass     @default(GENERATED_CONTENT)
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Editorial queues filter by locale/type/status; retention cleanup scans by class/expiry.
  @@unique([locale, slug])
  @@index([status, updatedAt])
  @@index([retentionClass, expiresAt])
  @@index([expiresAt])
  @@index([locale, type, status])
  @@index([contentPageId])
  @@index([aiRunId])
  @@map("article_drafts")
}

model AnalyticsEvent {
  id                    String         @id @default(cuid())
  idempotencyKey        String?        @unique
  sessionHash           String
  eventType             String
  source                String?
  locale                String?
  country               String?
  productId             String?
  product               Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  contentPageId         String?
  contentPage           ContentPage?   @relation(fields: [contentPageId], references: [id], onDelete: SetNull)
  socialPostId          String?
  socialPost            SocialPost?    @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  metadata              Json           @default("{}")
  metadataSchemaVersion Int            @default(1)
  retentionClass        RetentionClass @default(SHORT_LIVED)
  expiresAt             DateTime?
  occurredAt            DateTime       @default(now())
  createdAt             DateTime       @default(now())

  // Analytics reads are time-windowed by event/source/entity; retention cleanup scans by class/expiry.
  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@index([retentionClass, expiresAt])
  @@index([expiresAt])
  @@index([source, occurredAt])
  @@index([productId, occurredAt])
  @@index([contentPageId, occurredAt])
  @@index([socialPostId, occurredAt])
  @@index([sessionHash, occurredAt])
  @@map("analytics_events")
}

model ScheduledJob {
  id             String             @id @default(cuid())
  key            String             @unique
  name           String
  handler        String
  status         ScheduledJobStatus @default(ACTIVE)
  cronExpression String?
  timezone       String             @default("UTC")
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  lockKey        String?            @unique
  lockedBy       String?
  lockedUntil    DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  runs ScheduledJobRun[]

  // Schedulers poll enabled jobs by nextRunAt and use lockKey/lockedUntil for coarse-grained worker locks.
  @@index([status, nextRunAt])
  @@index([lockedUntil])
  @@map("scheduled_jobs")
}

model ScheduledJobRun {
  id             String                @id @default(cuid())
  scheduledJobId String
  scheduledJob   ScheduledJob          @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)
  aiRunId        String?
  aiRun          AiRun?                @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  idempotencyKey String?               @unique
  status         ScheduledJobRunStatus @default(PENDING)
  scheduledFor   DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  attempt        Int                   @default(1)
  lockedBy       String?
  lockExpiresAt  DateTime?
  error          String?               @db.Text
  output         Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // Idempotency is enforced per job/scheduled slot; workers claim pending/running rows by lock expiry.
  @@unique([scheduledJobId, scheduledFor])
  @@index([scheduledJobId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([lockExpiresAt])
  @@index([aiRunId])
  @@map("scheduled_job_runs")
}

model OptimizationRecommendation {
  id             String                           @id @default(cuid())
  idempotencyKey String?                          @unique
  productId      String?
  product        Product?                         @relation(fields: [productId], references: [id], onDelete: SetNull)
  contentPageId  String?
  contentPage    ContentPage?                     @relation(fields: [contentPageId], references: [id], onDelete: SetNull)
  socialPostId   String?
  socialPost     SocialPost?                      @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  trendSignalId  String?
  trendSignal    TrendSignal?                     @relation(fields: [trendSignalId], references: [id], onDelete: SetNull)
  type           String
  recommendation String                           @db.Text
  rationale      String?                          @db.Text
  priority       Int                              @default(0)
  impactScore    Float?
  status         OptimizationRecommendationStatus @default(OPEN)
  metadata       Json?
  retentionClass RetentionClass                   @default(STANDARD)
  expiresAt      DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  // Optimization queues group open recommendations by target entity/priority; retention cleanup scans by class/expiry.
  @@index([status, priority])
  @@index([retentionClass, expiresAt])
  @@index([expiresAt])
  @@index([productId, status])
  @@index([contentPageId, status])
  @@index([socialPostId, status])
  @@index([trendSignalId, status])
  @@map("optimization_recommendations")
}

model ApprovalAuditEvent {
  id         String                  @id @default(cuid())
  actorType  ApprovalAuditActorType
  actorId    String
  action     ApprovalAuditAction
  entityType ApprovalAuditEntityType
  entityId   String
  reason     String?                 @db.Text
  metadata   Json                    @default("{}")
  createdAt  DateTime                @default(now())

  // Append-only approval decision trail: create-only timestamp and no mutable foreign-key coupling.
  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("approval_audit_events")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model AgentConfig {
  id          String   @id @default(cuid())
  agentName   String   @unique
  model       String   @default("google/gemini-2.5-flash")
  temperature Float    @default(0.3)
  maxTokens   Int      @default(2000)
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("agent_configs")
}

model CircuitBreakerState {
  id            String    @id @default(cuid())
  name          String    @unique
  isTripped     Boolean   @default(false)
  tripCount     Int       @default(0)
  lastTrippedAt DateTime?
  resetAt       DateTime?
  metadata      Json?
  updatedAt     DateTime  @updatedAt

  @@map("circuit_breaker_states")
}

// ==================== AI OS MODELS ====================

model AiRun {
  id          String      @id @default(cuid())
  name        String
  type        AiRunType
  status      AiRunStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?     @db.Text
  tokensUsed  Int?
  costUsd     Decimal?    @db.Decimal(10, 6)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  steps            AiRunStep[]
  artifacts        AiArtifact[]
  events           AiEvent[]
  approvals        AiApproval[]
  costLogs         AiCostLog[]
  productScores    ProductScore[]
  articleDrafts    ArticleDraft[]
  scheduledJobRuns ScheduledJobRun[]

  @@index([type, status])
  @@index([status])
  @@index([createdAt])
  @@map("ai_runs")
}

model AiRunStep {
  id          String       @id @default(cuid())
  aiRunId     String
  aiRun       AiRun        @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  stepName    String
  status      AiStepStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?      @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([aiRunId])
  @@map("ai_run_steps")
}

model AiArtifact {
  id        String         @id @default(cuid())
  aiRunId   String
  aiRun     AiRun          @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  type      AiArtifactType
  name      String
  content   String?        @db.Text
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([aiRunId])
  @@map("ai_artifacts")
}

model AiEvent {
  id        String      @id @default(cuid())
  aiRunId   String
  aiRun     AiRun       @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  type      AiEventType
  message   String
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([aiRunId])
  @@map("ai_events")
}

model AiApproval {
  id         String           @id @default(cuid())
  aiRunId    String
  aiRun      AiRun            @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  stepName   String?
  status     AiApprovalStatus @default(PENDING)
  approverId String?
  comment    String?          @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([aiRunId])
  @@map("ai_approvals")
}

model AiCostLog {
  id         String   @id @default(cuid())
  aiRunId    String
  aiRun      AiRun    @relation(fields: [aiRunId], references: [id], onDelete: Cascade)
  tokensUsed Int?
  costUsd    Decimal  @db.Decimal(10, 6)
  model      String?
  provider   String?
  createdAt  DateTime @default(now())

  @@index([aiRunId])
  @@map("ai_cost_logs")
}

// ==================== AUTH (better-auth) ====================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}
