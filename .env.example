# OpenRouter AI API
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Database (Dokploy PostgreSQL)
DATABASE_URL=postgresql://babiespicks_user:PASSWORD@localhost:5432/babiespicks

# Redis (Dokploy)
REDIS_URL=redis://:PASSWORD@localhost:6379

# MinIO (Dokploy)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Frontend
NEXT_PUBLIC_API_URL=https://api.babiespicks.com
NEXT_PUBLIC_SITE_URL=https://babiespicks.com

# Environment
NODE_ENV=development
