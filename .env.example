# OpenRouter AI API
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Database (Dokploy PostgreSQL 16)
# Internal: postgresql://babiespicks_user:PASSWORD@babiespicks-babiespickspostgres-baix55:5432/babiespicks
DATABASE_URL=postgresql://babiespicks_user:PASSWORD@localhost:5432/babiespicks

# Redis 7 (Dokploy) - Cache + BullMQ
# Internal: redis://default:PASSWORD@babiespicks-babiespicksredis-wpixtx:6379
REDIS_URL=redis://default:PASSWORD@localhost:6379

# MinIO (shared-infra project in Dokploy)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Frontend
NEXT_PUBLIC_API_URL=https://api.babiespicks.com
NEXT_PUBLIC_SITE_URL=https://babiespicks.com

# GlitchTip Error Monitoring (https://errors.webvue.pro)
# API (babiespicks-api project)
GLITCHTIP_DSN=https://472bda7a3fa44da1a462a6adf25ce8b2@errors.webvue.pro/14
# Frontend (babiespicks-web project)
NEXT_PUBLIC_GLITCHTIP_DSN=https://22f9962016104e258edf7778e99222cf@errors.webvue.pro/13

# Resend (email delivery — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3001

# ArabClicks Affiliate Network
ARABCLICKS_PUBLISHER_ID=your_publisher_id
ARABCLICKS_ADVERTISER_ID=your_advertiser_id

# Admitad Affiliate Network
ADMITAD_CAMPAIGN_CODE=your_campaign_code

# Amazon Associates Affiliate Network (SA)
AMAZON_ASSOCIATES_TAG=your-amazon-tag

# Affiliate Search / SearXNG Proxy
AFFILIATE_SEARCH_BASE_URL=https://search.ploy.jsa.sa
AFFILIATE_SEARCH_FORMAT=json
AFFILIATE_SEARCH_API_KEY=

# Shadow mode — set to 'true' to skip real HTTP calls (returns mock data)
AFFILIATE_SHADOW_MODE=

# Noon Affiliate Network
NOON_AFFILIATE_CODE=your-noon-affiliate-code

# Telegram Bot (Social publishing — Phase P5)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@your_channel_username_or_-100xxxxxxxxxx

# Web admin login/session and backend proxy auth
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=change-this-admin-login-password
ADMIN_AUTH_SECRET=change-this-admin-session-signing-secret
ADMIN_API_KEY=your-secure-admin-key-here

# Environment
NODE_ENV=development

# Dify orchestration
DIFY_API_TOKEN=<generate with: openssl rand -hex 32>
