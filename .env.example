# Web + shared PostgreSQL. Local example only; use an isolated database for tests.
DATABASE_URL=postgresql://babiespicks:CHANGE_ME@db:5432/babiespicks
POSTGRES_PASSWORD=CHANGE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional analytics; empty means disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
MEDIA_ROOT=/data/media
REVALIDATE_SECRET=

# Independent MCP owner connection; never reuse Tariq Blog secrets.
MCP_PORT=8765
MCP_PUBLIC_URL=http://localhost:8765
MCP_OAUTH_SECRET=
MCP_ADMIN_PASSWORD=
MCP_BEARER_TOKEN=
ENABLE_MCP_PUBLISH=false
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_ALLOW_INTERNAL_HTTP=false

# Public shopping chat. Empty key keeps the chat hidden. Key stays server-side only.
DEPLOY_API_KEY=
DEPLOY_API_URL=https://api-cdn.deploy.com/api/v1
CHAT_MODEL=zai-org/glm-5.3-flash
CHAT_DAILY_BUDGET_USD=2

# Affiliate credentials; only configured programs produce attributed links.
# Legacy Saudi-only fallback. Never used for US.
AMAZON_ASSOCIATES_TAG=
# Scoped tag wins, then legacy SA (SA only), then the matching store URL tag.
# Missing configuration rejects the purchase URL. Keep US empty until authorized.
AMAZON_ASSOCIATES_TAG_SA=
AMAZON_ASSOCIATES_TAG_US=
ARABCLICKS_PUBLISHER_ID=
ARABCLICKS_ADVERTISER_ID=
ADMITAD_CAMPAIGN_CODE=
NOON_AFFILIATE_CODE=
# Explicit comma-separated additional allowed purchase/affiliate hostnames.
AFFILIATE_ALLOWED_HOSTS=

# Reserved market-data writer settings; names only, no live source is approved.
# Library refreshMarketData receives explicit config/clients; these do not enable
# a source, add a schedule, or start a second writer. Wire only after Task 11.
# MCP auth stays server-side; never use NEXT_PUBLIC_ or a DATABASE_URL for updater.
MARKET_DATA_MCP_URL=
MARKET_DATA_MCP_TOKEN=
MARKET_DATA_BATCH_SIZE=
MARKET_DATA_TIMEOUT_MS=
MARKET_DATA_PRICE_SOURCE_ID=
MARKET_DATA_FX_SOURCE_ID=

# Integration tests require an isolated database ending in _test.
TEST_DATABASE_URL=
